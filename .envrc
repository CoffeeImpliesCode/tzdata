# The canonical development environment for this SDK is devenv; see
# devenv.nix and devenv.yaml.  The Nix variants are built from outside this
# shell, not from inside it.
#
# `.envrc` is a dotfile, and upstream's .gitignore has a `.*` pattern, so
# .gitignore carries an explicit negation for this path.  Without it the file
# would be invisible to git and to Zig's package hashing.
export DIRENV_WARN_TIMEOUT=30s

eval "$(devenv direnvrc)"
use devenv